local function jsonDecode(value)
    return HttpService:JSONDecode(value)
end

local function safeRequest(options)
    if type(requestFn) ~= "function" then return nil, "HTTP requests not supported" end
    local ok, response = pcall(function() return requestFn(options) end)
    if ok and type(response) == "table" then return response end
    return nil, "Connection Error: " .. tostring(response or "Unknown")
end

local function getIdentifier()
    if type(gethwid) == "function" then
        local ok, value = pcall(gethwid)
        if ok and value then return tostring(value) end
    end
    local ok, value = pcall(function()
        return game:GetService("RbxAnalyticsService"):GetClientId()
    end)
    if ok and value then return tostring(value) end
    return tostring(Player.UserId)
end

local identifier = sha256(getIdentifier())

math.randomseed(os.clock() * 1000000 + Player.UserId)

local function proxyGet(action, extra)
    local url = proxyEndpoint .. "/?action=" .. HttpService:UrlEncode(action) .. "&identifier=" .. HttpService:UrlEncode(identifier)
    for name, value in pairs(extra or {}) do
        url = url .. "&" .. HttpService:UrlEncode(tostring(name)) .. "=" .. HttpService:UrlEncode(tostring(value))
    end
    return safeRequest({
        Url = url,
        Method = "GET",
        Headers = { ["Accept"] = "application/json" }
    })
end

local function decodeProxyResponse(response)
    if not response then
        return nil, "Unable to contact key server."
    end
    local statusCode = tonumber(response.StatusCode or response.status_code or response.Code or response.code)
    if statusCode and statusCode >= 400 then
        return nil, "Key server returned HTTP " .. tostring(statusCode)
    end
    local body = response.Body or response.body or response.ResponseBody or response.responseBody
    if type(body) ~= "string" then
        return nil, "Key server returned no response."
    end
    local ok, decoded = pcall(jsonDecode, body)
    if not ok or type(decoded) ~= "table" then
        return nil, "Invalid key server response."
    end
    return decoded
end

local function cacheLink()
    if cachedTime + 600 > os.time() and cachedLink ~= "" then
        return true, cachedLink
    end

    local response, err = proxyGet("start")
    if not response then
        return false, err or "Unable to contact key server."
    end

    local decoded, decodeErr = decodeProxyResponse(response)
    if not decoded then
        return false, decodeErr
    end

    if decoded.success == true and decoded.url then
        cachedLink = tostring(decoded.url)
        cachedTime = os.time()
        return true, cachedLink
    end

    return false, tostring(decoded.error or decoded.message or "Failed to generate key link.")
end

local function redeemKey(key)
    local response, err = proxyGet("redeem", {key = key})
    if not response then
        return false, err or "Unable to contact key server."
    end

    local decoded, decodeErr = decodeProxyResponse(response)
    if not decoded then
        return false, decodeErr
    end

    if decoded.authorized == true then
        if type(writefile) == "function" then
            pcall(writefile, Config.KeyFileName, key)
        end
        return true, "Success"
    end

    return false, tostring(decoded.error or decoded.message or "Invalid key.")
end

local function verifyKey(key)
    local response, err = proxyGet("verify", {key = key})
    if not response then
        return false, err or "Unable to contact key server."
    end

    local decoded, decodeErr = decodeProxyResponse(response)
    if not decoded then
        return false, decodeErr
    end

    if decoded.authorized == true then
        if type(writefile) == "function" then
            pcall(writefile, Config.KeyFileName, key)
        end
        return true, "Success"
    end

    if key:sub(1, 5) == "FREE_" then
        return redeemKey(key)
    end

    return false, tostring(decoded.error or decoded.message or "Invalid key.")
end

