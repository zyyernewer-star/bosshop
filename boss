local function hex(x)
    return string.gsub(x, ".", function(ch) return string.format("%02x", string.byte(ch)) end)
end
local function pack(n, bytes)
    local out = ""
    for _ = 1, bytes do
        local byte = n % 256
        out = string.char(byte) .. out
        n = (n - byte) / 256
    end
    return out
end
local function word(data, index)
    local v = 0
    for i = index, index + 3 do v = v * 256 + string.byte(data, i) end
    return v
end
local function pad(data, len)
    local h = 64 - (len + 9) % 64
    local bitLen = pack(8 * len, 8)
    local result = data .. "\128" .. string.rep("\0", h) .. bitLen
    assert(#result % 64 == 0)
    return result
end
local function initState(state)
    state[1]=0x6a09e667; state[2]=0xbb67ae85; state[3]=0x3c6ef372; state[4]=0xa54ff53a
    state[5]=0x510e527f; state[6]=0x9b05688c; state[7]=0x1f83d9ab; state[8]=0x5be0cd19
    return state
end
local function compress(data, startAt, state)
    local w = {}
    for i = 1, 16 do w[i] = word(data, startAt + (i - 1) * 4) end
    for i = 17, 64 do
        local s0 = w[i - 15]
        local s1 = w[i - 2]
        local sigma0 = bxor(rotr(s0, 7), rotr(s0, 18), shift(s0, 3))
        local sigma1 = bxor(rotr(s1, 17), rotr(s1, 19), shift(s1, 10))
        w[i] = (w[i - 16] + sigma0 + w[i - 7] + sigma1) % a
    end
    local aa,bb,cc,dd,ee,ff,gg,hh = state[1],state[2],state[3],state[4],state[5],state[6],state[7],state[8]
    for i = 1, 64 do
        local S1 = bxor(rotr(ee, 6), rotr(ee, 11), rotr(ee, 25))
        local ch = bxor(band(ee, ff), band(bnot(ee), gg))
        local temp1 = (hh + S1 + ch + k[i] + w[i]) % a
        local S0 = bxor(rotr(aa, 2), rotr(aa, 13), rotr(aa, 22))
        local maj = bxor(band(aa, bb), band(aa, cc), band(bb, cc))
        local temp2 = (S0 + maj) % a
        hh,gg,ff,ee,dd,cc,bb,aa = gg,ff,ee,(dd + temp1) % a,cc,bb,aa,(temp1 + temp2) % a
    end
    state[1]=(state[1]+aa)%a; state[2]=(state[2]+bb)%a; state[3]=(state[3]+cc)%a; state[4]=(state[4]+dd)%a
    state[5]=(state[5]+ee)%a; state[6]=(state[6]+ff)%a; state[7]=(state[7]+gg)%a; state[8]=(state[8]+hh)%a
end
local function sha256(data)
    data = pad(data, #data)
    local state = initState({})
    for i = 1, #data, 64 do compress(data, i, state) end
    return hex(pack(state[1],4)..pack(state[2],4)..pack(state[3],4)..pack(state[4],4)..pack(state[5],4)..pack(state[6],4)..pack(state[7],4)..pack(state[8],4))
end

