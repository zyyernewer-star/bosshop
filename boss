        local existing = PlayerGui:FindFirstChild(Config.KeyGuiName)
        if existing then existing:Destroy() end
    end)
    pcall(function()
        local existing = CoreGui:FindFirstChild(Config.KeyGuiName)
        if existing then existing:Destroy() end
    end)
end

local function loadMainScript()
    if loadingStarted then return end
    loadingStarted = true
    destroyKeyGui()
    task.spawn(function()
        local ok, err = pcall(function()
            if PlayerGui:FindFirstChild(Config.MainGuiName) then
                PlayerGui[Config.MainGuiName]:Destroy()
            end
            local source = cachedMainSource
            if type(source) ~= "string" or source == "" then
                source = game:HttpGet(Config.MainScriptURL)
            end
            local fn = loadstring(source)
            assert(type(fn) == "function", "loadstring failed")
            fn()
        end)
        if not ok then
            warn("[Empire] Main script failed to load: " .. tostring(err))
        end
    end)
end

