local a = 2 ^ 32
local b = a - 1
local function band(d, e)
    local f, g = 0, 1
    while d ~= 0 or e ~= 0 do
        local h, i = d % 2, e % 2
        local j = (h + i) % 2
        f = f + j * g
        d = math.floor(d / 2)
        e = math.floor(e / 2)
        g = g * 2
    end
    return f % a
end
local function bxor(d, e, l, ...)
    local m
    if e then
        d, e = d % a, e % a
        m = band(d, e)
        if l then m = bxor(m, l, ...) end
        return m
    elseif d then
        return d % a
    end
    return 0
end
local function bor(d, e, l, ...)
    local m
    if e then
        d, e = d % a, e % a
        m = (d + e - band(d, e)) / 2
        if l then m = bor(m, l, ...) end
        return m
    elseif d then
        return d % a
    end
    return b
end
local function bnot(p) return b - p end
local function rshift(d, r)
    if r < 0 then return lshift(d, -r) end
    return math.floor(d % 2 ^ 32 / 2 ^ r)
end
local function shift(d, r)
    if r > 31 or r < -31 then return 0 end
    return rshift(d % a, r)
end
function lshift(d, r)
    if r < 0 then return shift(d, -r) end
    return d * 2 ^ r % 2 ^ 32
end
local function rotr(p, r)
    if r > 31 then r = r % 32 end
    if r < 0 then r = r % 32 end
    local u = bor(p % a, 2 ^ r - 1)
    return shift(p, r) + lshift(u, 32 - r)
end
